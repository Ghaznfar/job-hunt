# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# DATABASE_URL is used at runtime (may be a pooled connection).
# DIRECT_URL is used by `prisma migrate` (must be a direct, non-pooled connection).
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobhunt?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/jobhunt?schema=public

# ---------------------------------------------------------------------------
# Auth.js (NextAuth v5)
# AUTH_SECRET: generate with `openssl rand -base64 32`
# ADMIN_EMAILS: comma separated; these accounts are promoted to ADMIN on login
# ---------------------------------------------------------------------------
AUTH_URL=http://localhost:3000
AUTH_SECRET=replace-me-with-a-32-byte-base64-secret
AUTH_TRUST_HOST=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# AI provider abstraction
# AI_PROVIDER: mock | anthropic | openai   (mock requires no key)
# ---------------------------------------------------------------------------
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Blend weights: deterministic rule engine vs AI adjustment (must sum to 1.0)
AI_RULE_WEIGHT=0.7
AI_AI_WEIGHT=0.3

# ---------------------------------------------------------------------------
# Job provider abstraction
# JOB_PROVIDERS: comma separated list of enabled providers: mock,adzuna
# Adzuna is a ToS-compliant official API (https://developer.adzuna.com/)
# ---------------------------------------------------------------------------
JOB_PROVIDERS=mock
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Shared secret required to call /api/cron/* endpoints
CRON_SECRET=replace-me-with-a-random-string

# ---------------------------------------------------------------------------
# File storage abstraction
# STORAGE_DRIVER: local | s3
# Uploaded CVs are ALWAYS private; access is via short-lived signed URLs.
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./.uploads
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
MAX_UPLOAD_MB=8

# ---------------------------------------------------------------------------
# Rate limiting abstraction
# RATELIMIT_DRIVER: postgres | redis | memory
# ---------------------------------------------------------------------------
RATELIMIT_DRIVER=postgres
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Stripe (test mode until the MVP is signed off)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_PORTAL_RETURN_URL=http://localhost:3000/dashboard/settings

# ---------------------------------------------------------------------------
# Email abstraction
# EMAIL_DRIVER: console | resend
# ---------------------------------------------------------------------------
EMAIL_DRIVER=console
RESEND_API_KEY=
EMAIL_FROM="JobHunt <noreply@localhost>"

# ---------------------------------------------------------------------------
# Free plan monthly limits
# ---------------------------------------------------------------------------
FREE_MONTHLY_JOB_MATCH=10
FREE_MONTHLY_CV_ANALYSIS=3
FREE_MONTHLY_AI_GENERATIONS=5
