// Prisma schema for the AI Job Hunting SaaS MVP.
// Design notes:
//  - All user-owned data cascades on User delete (GDPR / account deletion).
//  - Money is stored as integer minor units? -> we keep whole-number amounts + ISO currency, no FX.
//  - Enums are used for finite state; free-form text kept in Json / String[] where a controlled
//    vocabulary is not yet warranted.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Auth / User
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  emailVerified  DateTime?
  hashedPassword String?
  name           String?
  image          String?
  role           UserRole  @default(USER)
  disabledAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  profile             Profile?
  subscription        Subscription?
  resumes             Resume[]
  userSkills          UserSkill[]
  jobMatches          JobMatch[]
  savedJobs           SavedJob[]
  applications        Application[]
  interviewQuestions  InterviewQuestion[]
  coverLetters        CoverLetter[]
  skillGapReports     SkillGapReport[]
  usageCounters       UsageCounter[]
  aiRequests          AIRequest[]
  auditLogs           AuditLog[]        @relation("AuditActor")
  passwordResetTokens PasswordResetToken[]

  @@index([role])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Profile & skills
// ---------------------------------------------------------------------------

enum WorkPreference {
  REMOTE
  HYBRID
  ONSITE
}

model Profile {
  id                String          @id @default(cuid())
  userId            String          @unique
  country           String?
  city              String?
  linkedinUrl       String?
  githubUrl         String?
  portfolioUrl      String?
  currentTitle      String?
  yearsExperience   Float?
  desiredTitles     String[]
  targetCountries   String[]
  workPreference    WorkPreference?
  salaryExpectation Int?
  salaryCurrency    String?         @default("USD")
  // { "US": "CITIZEN" | "PERMANENT_RESIDENT" | "VISA_HOLDER" | "NEEDS_SPONSORSHIP" | "NONE" }
  workAuthorizations Json           @default("{}")
  needsSponsorship  Boolean         @default(false)
  onboardingCompletedAt DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Skill {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  category  String?
  aliases   String[]
  createdAt DateTime @default(now())

  userSkills   UserSkill[]
  jobSkills    JobSkill[]
  resumeSkills ResumeSkill[]

  @@index([category])
}

model UserSkill {
  id        String   @id @default(cuid())
  userId    String
  skillId   String
  level     SkillLevel?
  yearsUsed Float?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([skillId])
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

// ---------------------------------------------------------------------------
// Resume
// ---------------------------------------------------------------------------

enum ResumeFileType {
  PDF
  DOCX
}

enum ResumeVersionSource {
  UPLOAD
  EDIT
  TAILORED
}

model Resume {
  id        String          @id @default(cuid())
  userId    String
  name      String
  isDefault Boolean         @default(false)
  fileKey   String?
  fileType  ResumeFileType?
  rawText   String?         @db.Text
  parsedAt  DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions ResumeVersion[]

  @@index([userId])
}

model ResumeVersion {
  id              String              @id @default(cuid())
  resumeId        String
  label           String
  source          ResumeVersionSource @default(UPLOAD)
  tailoredForJobId String?
  summary         String?             @db.Text
  isCurrent       Boolean             @default(false)
  createdAt       DateTime            @default(now())

  resume         Resume          @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  tailoredForJob Job?            @relation(fields: [tailoredForJobId], references: [id], onDelete: SetNull)
  experiences    Experience[]
  educations     Education[]
  certifications Certification[]
  projects       Project[]
  languages      Language[]
  resumeSkills   ResumeSkill[]
  jobMatches     JobMatch[]
  applications   Application[]
  coverLetters   CoverLetter[]

  @@index([resumeId])
  @@index([tailoredForJobId])
}

model Experience {
  id              String    @id @default(cuid())
  resumeVersionId String
  company         String
  title           String
  location        String?
  startDate       String?
  endDate         String?
  current         Boolean   @default(false)
  bullets         String[]
  techs           String[]
  sortOrder       Int       @default(0)

  resumeVersion ResumeVersion @relation(fields: [resumeVersionId], references: [id], onDelete: Cascade)

  @@index([resumeVersionId])
}

model Education {
  id              String  @id @default(cuid())
  resumeVersionId String
  institution     String
  degree          String?
  field           String?
  startDate       String?
  endDate         String?
  grade           String?
  sortOrder       Int     @default(0)

  resumeVersion ResumeVersion @relation(fields: [resumeVersionId], references: [id], onDelete: Cascade)

  @@index([resumeVersionId])
}

model Certification {
  id              String  @id @default(cuid())
  resumeVersionId String
  name            String
  issuer          String?
  issuedAt        String?
  expiresAt       String?
  sortOrder       Int     @default(0)

  resumeVersion ResumeVersion @relation(fields: [resumeVersionId], references: [id], onDelete: Cascade)

  @@index([resumeVersionId])
}

model Project {
  id              String   @id @default(cuid())
  resumeVersionId String
  name            String
  description     String?  @db.Text
  techs           String[]
  url             String?
  sortOrder       Int      @default(0)

  resumeVersion ResumeVersion @relation(fields: [resumeVersionId], references: [id], onDelete: Cascade)

  @@index([resumeVersionId])
}

model Language {
  id              String  @id @default(cuid())
  resumeVersionId String
  name            String
  proficiency     String?
  sortOrder       Int     @default(0)

  resumeVersion ResumeVersion @relation(fields: [resumeVersionId], references: [id], onDelete: Cascade)

  @@index([resumeVersionId])
}

model ResumeSkill {
  id              String @id @default(cuid())
  resumeVersionId String
  skillId         String
  rawLabel        String?

  resumeVersion ResumeVersion @relation(fields: [resumeVersionId], references: [id], onDelete: Cascade)
  skill         Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([resumeVersionId, skillId])
  @@index([skillId])
}

// ---------------------------------------------------------------------------
// Jobs
// ---------------------------------------------------------------------------

enum WorkArrangement {
  REMOTE
  HYBRID
  ONSITE
  UNKNOWN
}

enum SponsorshipAvailability {
  YES
  NO
  UNKNOWN
}

enum JobSkillImportance {
  REQUIRED
  PREFERRED
}

enum ExtractionMethod {
  RULE
  AI
}

model JobSource {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  enabled   Boolean  @default(true)
  config    Json     @default("{}")
  lastRunAt DateTime?
  createdAt DateTime @default(now())

  jobs Job[]
}

model Job {
  id                       String                  @id @default(cuid())
  sourceId                 String
  externalId               String
  title                    String
  company                  String
  companyDomain            String?
  location                 String?
  country                  String
  workArrangement          WorkArrangement         @default(UNKNOWN)
  employmentType           String?
  seniorityLevel           String?
  minYearsRequired         Float?
  maxYearsRequired         Float?
  salaryMin                Int?
  salaryMax                Int?
  salaryCurrency           String?
  description              String                  @db.Text
  requirementsText         String?                 @db.Text
  requiresWorkAuthorization String[]
  sponsorshipAvailable     SponsorshipAvailability @default(UNKNOWN)
  extractionConfidence     Float?
  analyzedAt               DateTime?
  url                      String
  postedAt                 DateTime?
  fingerprint              String
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  source        JobSource       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  jobSkills     JobSkill[]
  jobMatches    JobMatch[]
  savedJobs     SavedJob[]
  applications  Application[]
  interviewQuestions InterviewQuestion[]
  coverLetters  CoverLetter[]
  resumeVersions ResumeVersion[]

  @@unique([sourceId, externalId])
  @@index([fingerprint])
  @@index([country, postedAt])
  @@index([title])
  @@index([workArrangement])
}

model JobSkill {
  id         String             @id @default(cuid())
  jobId      String
  skillId    String
  importance JobSkillImportance @default(REQUIRED)
  extractedBy ExtractionMethod  @default(RULE)

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobId, skillId])
  @@index([skillId])
}

// ---------------------------------------------------------------------------
// Matching / decision
// ---------------------------------------------------------------------------

enum ApplyVerdict {
  APPLY
  MAYBE
  DONT_APPLY
}

model JobMatch {
  id               String       @id @default(cuid())
  userId           String
  jobId            String
  resumeVersionId  String?
  overallScore     Int
  technicalScore   Int
  experienceScore  Int
  locationScore    Int
  salaryScore      Int
  seniorityScore   Int
  eligibilityScore Int
  verdict          ApplyVerdict
  reasons          String[]
  concerns         String[]
  skillScores      Json         @default("[]")
  strongMatches    String[]
  missingSkills    String[]
  recommendation   String       @db.Text
  aiModel          String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  job           Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resumeVersion ResumeVersion? @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)

  @@unique([userId, jobId, resumeVersionId])
  @@index([userId])
  @@index([jobId])
}

model SavedJob {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  notes     String?  @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Applications
// ---------------------------------------------------------------------------

enum ApplicationStatus {
  SAVED
  APPLIED
  SCREENING
  INTERVIEW
  TECHNICAL_INTERVIEW
  FINAL_INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

model Application {
  id              String            @id @default(cuid())
  userId          String
  jobId           String?
  company         String
  title           String
  jobUrl          String?
  salary          String?
  status          ApplicationStatus @default(SAVED)
  boardOrder      Int               @default(0)
  appliedAt       DateTime?
  source          String?
  contactName     String?
  contactEmail    String?
  nextInterviewAt DateTime?
  resumeVersionId String?
  coverLetterId   String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  job           Job?             @relation(fields: [jobId], references: [id], onDelete: SetNull)
  resumeVersion ResumeVersion?   @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)
  coverLetter   CoverLetter?     @relation(fields: [coverLetterId], references: [id], onDelete: SetNull)
  notes         ApplicationNote[]
  events        ApplicationEvent[]
  interviews    Interview[]

  @@index([userId, status])
  @@index([jobId])
}

model ApplicationNote {
  id            String   @id @default(cuid())
  applicationId String
  body          String   @db.Text
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model ApplicationEvent {
  id            String             @id @default(cuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  createdAt     DateTime           @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

enum InterviewType {
  PHONE_SCREEN
  TECHNICAL
  SYSTEM_DESIGN
  BEHAVIORAL
  ONSITE
  FINAL
  OTHER
}

model Interview {
  id            String        @id @default(cuid())
  applicationId String
  type          InterviewType @default(OTHER)
  scheduledAt   DateTime?
  notes         String?       @db.Text
  outcome       String?
  createdAt     DateTime      @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

// ---------------------------------------------------------------------------
// AI outputs
// ---------------------------------------------------------------------------

enum InterviewQuestionCategory {
  TECHNICAL
  SCENARIO
  BEHAVIORAL
  HR
  JOB_SPECIFIC
}

model InterviewQuestion {
  id             String                    @id @default(cuid())
  userId         String
  jobId          String
  category       InterviewQuestionCategory
  question       String                    @db.Text
  userAnswer     String?                   @db.Text
  aiFeedback     String?                   @db.Text
  improvedAnswer String?                   @db.Text
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([userId, jobId])
}

model CoverLetter {
  id              String   @id @default(cuid())
  userId          String
  jobId           String
  resumeVersionId String?
  content         String   @db.Text
  tone            String   @default("professional")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  job           Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resumeVersion ResumeVersion? @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)
  applications  Application[]

  @@index([userId, jobId])
}

model SkillGapReport {
  id           String   @id @default(cuid())
  userId       String
  targetTitles String[]
  topSkills    Json     @default("[]")
  summary      String?  @db.Text
  generatedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Billing & metering
// ---------------------------------------------------------------------------

enum SubscriptionPlan {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
  UNPAID
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  plan                 SubscriptionPlan   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum UsageFeature {
  JOB_MATCH
  CV_ANALYSIS
  CV_TAILOR
  COVER_LETTER
  INTERVIEW_PREP
  SKILL_GAP
  CAREER_ADVICE
}

model UsageCounter {
  id      String       @id @default(cuid())
  userId  String
  period  String // YYYY-MM
  feature UsageFeature
  count   Int          @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period, feature])
  @@index([userId])
}

enum AIRequestStatus {
  OK
  ERROR
}

model AIRequest {
  id               String          @id @default(cuid())
  userId           String?
  feature          String
  provider         String
  model            String
  promptTokens     Int?
  completionTokens Int?
  costCents        Int?
  latencyMs        Int?
  status           AIRequestStatus @default(OK)
  error            String?         @db.Text
  createdAt        DateTime        @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([feature])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Ops
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  target    String?
  meta      Json     @default("{}")
  createdAt DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId])
}

model RateLimit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

model ErrorLog {
  id        String   @id @default(cuid())
  level     LogLevel @default(ERROR)
  source    String?
  message   String   @db.Text
  context   Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([level])
}
