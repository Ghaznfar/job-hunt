# Copy to .env.prod on the VM and fill in. Keep this file OFF the server's git.
#
# Required
APP_DOMAIN=jobhunt.example
APP_URL=https://jobhunt.example
APP_IMAGE=ghcr.io/YOUR_GH_USERNAME/ai-hunting-job-saas-mvp:latest
AUTH_SECRET=            # openssl rand -base64 32
CRON_SECRET=            # openssl rand -hex 24
POSTGRES_PASSWORD=      # openssl rand -hex 24
POSTGRES_USER=jobhunt
POSTGRES_DB=jobhunt
ADMIN_EMAILS=you@example.com

# AI (optional — omit to run on the deterministic mock)
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Jobs (optional — omit to use the 64-role demo dataset)
JOB_PROVIDERS=mock
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# CV storage — S3 strongly recommended in production (local disk is per-container)
STORAGE_DRIVER=s3
S3_REGION=us-east-1
S3_BUCKET=jobhunt-cv-uploads-CHANGEME
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=            # only for non-AWS S3-compatible stores

RATELIMIT_DRIVER=postgres

# Stripe (optional until you enable paid plans)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRO_PRICE_ID=

# Email (optional — console driver just logs)
EMAIL_DRIVER=console
RESEND_API_KEY=
EMAIL_FROM=JobHunt <noreply@jobhunt.example>
